---
import ExamplesLayout from '../../layouts/ExamplesLayout.astro';
import CodeSample from '../../components/CodeSample.astro';

const install = 'pnpm add -D @postcss-go/core autoprefixer';
const config = `export default {
  plugins: {
    autoprefixer: {},
  },
};`;
const cli = 'pnpm postcss-go src/index.css -u autoprefixer -o dist/index.css';
---

<ExamplesLayout title="Autoprefixer" section="autoprefixer">
  <h1>Autoprefixer</h1>
  <p>The smallest useful plugin chain: parse with Go, run Autoprefixer, stringify with Go.</p>
  <CodeSample filename="terminal" code={install} />
  <CodeSample filename="postcss.config.js" code={config} />
  <p>Or skip the config file and load the plugin from the CLI:</p>
  <CodeSample filename="terminal" code={cli} />
</ExamplesLayout>
